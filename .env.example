# Placeholders only. Copy to .env for local work (.env is git-ignored).
# Never commit a real secret, and never commit a customer virtual key.

PORT=4000
STORE_MODEL_IN_DB=True
LITELLM_NUM_WORKERS=4

# On Render both are wired from the managed Postgres and Key Value instances.
# REDIS_URL is required whenever LITELLM_NUM_WORKERS is above 1.
DATABASE_URL=postgresql://litellm:REPLACE_ME@localhost:5432/litellm
REDIS_URL=redis://localhost:6379

# Generate separately (README D). They must differ, and LITELLM_SALT_KEY must
# never change once models exist - it encrypts stored provider credentials.
LITELLM_MASTER_KEY=sk-REPLACE_WITH_A_LONG_RANDOM_MASTER_KEY
LITELLM_SALT_KEY=sk-REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SALT_KEY

# Resource endpoint, not the Foundry project endpoint. Paste the portal's Azure
# OpenAI endpoint as-is; render_start.sh strips any /openai/v1 suffix.
AZURE_OPENAI_API_BASE=https://REPLACE_RESOURCE_NAME.openai.azure.com

# Optional. Unset means LiteLLM v1.99.0's default, 2025-02-01-preview.
# AZURE_API_VERSION=2025-02-01-preview

# Entra service principal. No Azure API key is used anywhere in this deployment.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=REPLACE_WITH_ENTRA_CLIENT_SECRET

# Optional; render_start.sh exports this documented default when unset.
# AZURE_SCOPE=https://cognitiveservices.azure.com/.default

# Operator scripts. LITELLM_API_KEY is a customer virtual key, never the master.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-REPLACE_WITH_A_CUSTOMER_VIRTUAL_KEY
